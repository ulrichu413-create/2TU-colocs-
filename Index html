async function isBiometricAvailable() {
  return !!(window.PublicKeyCredential &&
    PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable &&
    await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable());
}

function bytesToBase64url(bytes) {
  let s = "";
  for (const b of bytes) s += String.fromCharCode(b);
  return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

function base64urlToBytes(str) {
  const pad = "=".repeat((4 - str.length % 4) % 4);
  const bin = atob(str.replace(/-/g, "+").replace(/_/g, "/") + pad);
  return Uint8Array.from(bin, c => c.charCodeAt(0));
}

async function registerAdminPasskey() {
  if (!window.isSecureContext) {
    throw new Error("HTTPS_REQUIRED");
  }
  if (!(await isBiometricAvailable())) {
    throw new Error("BIOMETRIC_UNAVAILABLE");
  }

  const challenge = crypto.getRandomValues(new Uint8Array(32));
  const userId = crypto.getRandomValues(new Uint8Array(16));

  const credential = await navigator.credentials.create({
    publicKey: {
      challenge,
      rp: { name: "Gida Coloc", id: location.hostname },
      user: {
        id: userId,
        name: "gida-admin",
        displayName: "Administrateur Gida Coloc"
      },
      pubKeyCredParams: [
        { type: "public-key", alg: -7 },
        { type: "public-key", alg: -257 }
      ],
      authenticatorSelection: {
        authenticatorAttachment: "platform",
        userVerification: "required",
        residentKey: "required"
      },
      timeout: 60000,
      attestation: "none"
    }
  });

  localStorage.setItem("gida_admin_passkey_id",
    bytesToBase64url(new Uint8Array(credential.rawId)));
  return true;
}

async function unlockWithAdminPasskey() {
  if (!window.isSecureContext) {
    throw new Error("HTTPS_REQUIRED");
  }
  if (!(await isBiometricAvailable())) {
    throw new Error("BIOMETRIC_UNAVAILABLE");
  }

  const saved = localStorage.getItem("gida_admin_passkey_id");
  if (!saved) {
    await registerAdminPasskey();
    return true;
  }

  const credential = await navigator.credentials.get({
    publicKey: {
      challenge: crypto.getRandomValues(new Uint8Array(32)),
      allowCredentials: [{
        type: "public-key",
        id: base64urlToBytes(saved)
      }],
      userVerification: "required",
      timeout: 60000
    }
  });

  return !!credential;
}

function Admin({ items, setItems, pays, setPays, contacts }) {
  const [pin, setPin] = useState("");
  const [isAuth, setIsAuth] = useState(() => sessionStorage.getItem('gida_admin_auth') === 'true');
  const [attempts, setAttempts] = useState(0);
  const [lockoutTime, setLockoutTime] = useState(0);
  const [errMsg, setErrMsg] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [bioLoading, setBioLoading] = useState(false);
  const [bioAvailable, setBioAvailable] = useState(false);
  const [n, setN] = useState({ title: "", prix: "", quartier: "Sabon Gari", type: TYPES[0] });

  useEffect(() => {
    let alive = true;
    isBiometricAvailable().then(ok => { if (alive) setBioAvailable(ok); }).catch(() => {});
    return () => { alive = false; };
  }, []);

  useEffect(() => {
    if (lockoutTime > 0) {
      const timer = setInterval(() => {
        setLockoutTime(prev => {
          if (prev <= 1) {
            clearInterval(timer);
            setAttempts(0);
            return 0;
          }
          return prev - 1;
        });
      }, 1000);
      return () => clearInterval(timer);
    }
  }, [lockoutTime]);

  const handleLogin = async (e) => {
    e.preventDefault();
    if (lockoutTime > 0) return;
    if (!pin) {
      setErrMsg("Veuillez saisir un code.");
      return;
    }

    setIsLoading(true);
    setErrMsg("");

    try {
      const inputHash = await hashString(pin.trim());
      if (inputHash === PIN_HASH_SHA256) {
        setIsAuth(true);
        sessionStorage.setItem('gida_admin_auth', 'true');
        setAttempts(0);
        setPin("");
      } else {
        const nextAttempts = attempts + 1;
        setAttempts(nextAttempts);
        if (nextAttempts >= 3) {
          setLockoutTime(30);
          setErrMsg("Trop de tentatives. Bloqué pendant 30 secondes.");
        } else {
          setErrMsg(`Code PIN incorrect. (${3 - nextAttempts} tentative(s) restante(s))`);
        }
      }
    } catch (err) {
      setErrMsg("Erreur de vérification du code.");
    } finally {
      setIsLoading(false);
    }
  };

  const handleBiometricLogin = async () => {
    if (bioLoading || lockoutTime > 0) return;
    setBioLoading(true);
    setErrMsg("");

    try {
      await unlockWithAdminPasskey();
      setIsAuth(true);
      sessionStorage.setItem("gida_admin_auth", "true");
      setAttempts(0);
    } catch (err) {
      if (err && err.message === "HTTPS_REQUIRED") {
        setErrMsg("L'empreinte nécessite que le site soit ouvert en HTTPS.");
      } else if (err && err.message === "BIOMETRIC_UNAVAILABLE") {
        setErrMsg("La biométrie de ce téléphone/navigateur n'est pas disponible.");
      } else if (err && err.name === "NotAllowedError") {
        setErrMsg("Authentification biométrique annulée ou refusée.");
      } else {
        setErrMsg("Impossible d'utiliser l'empreinte. Utilisez le PIN 2026.");
      }
    } finally {
      setBioLoading(false);
    }
  };

  const handleLogout = () => {
    sessionStorage.removeItem('gida_admin_auth');
    setIsAuth(false);
    setPin("");
  };

  if (!isAuth) return (
    <div className="mx-auto max-w-sm px-4 py-16">
      <div className="gida-modern-card card rounded-2xl p-6 text-center shadow-lg">
        <div className="mx-auto grid h-14 w-14 place-items-center rounded-2xl" style={{ background: "var(--soft)", color: "var(--brand)" }}>
          <Icon n="lock" s={28} />
        </div>
        <h1 className="mt-4 text-xl font-extrabold">Espace Administration</h1>
        <p className="mut text-sm mt-1">Accès sécurisé réservé au gestionnaire.</p>
        
        <form onSubmit={handleLogin} className="mt-5 space-y-3">
          <input 
            type="password" 
            inputMode="numeric" 
            className={inp + " text-center font-mono text-lg tracking-widest"} 
            style={ist} 
            placeholder="••••" 
            value={pin} 
            disabled={lockoutTime > 0 || isLoading}
            onChange={e => { setPin(e.target.value); setErrMsg(""); }} 
          />
          {errMsg && <p className="text-xs font-semibold text-red-500">{errMsg}</p>}
          {lockoutTime > 0 && <p className="text-xs font-bold text-amber-600">Patientez {lockoutTime}s avant de réessayer.</p>}
          <button 
            type="submit" 
            disabled={lockoutTime > 0 || isLoading || bioLoading} 
            className="btn w-full rounded-xl px-4 py-3 font-bold disabled:opacity-50"
          >
            {isLoading ? "Vérification..." : "🔢 Déverrouiller avec le PIN"}
          </button>
        </form>

        <div className="my-4 flex items-center gap-2">
          <span className="h-px flex-1" style={{ background: "var(--line)" }}></span>
          <span className="mut text-xs font-semibold">OU</span>
          <span className="h-px flex-1" style={{ background: "var(--line)" }}></span>
        </div>

        <button
          type="button"
          onClick={handleBiometricLogin}
          disabled={lockoutTime > 0 || bioLoading}
          className="w-full rounded-xl border px-4 py-3 font-bold transition-colors hover:bg-black/5 disabled:opacity-50"
          style={{ borderColor: "var(--line)" }}
        >
          {bioLoading ? "Vérification biométrique..." : "👆 Déverrouiller avec l'empreinte"}
        </button>

        {!window.isSecureContext && (
          <p className="mt-2 text-[11px] font-semibold text-amber-600">
            L'empreinte sera disponible lorsque le site sera en HTTPS.
          </p>
        )}

        <p className="mut mt-4 text-[11px] leading-relaxed">
          🔐 Deux méthodes : PIN 2026 ou biométrie/passkey du téléphone. La biométrie doit être activée sur l'appareil et le site doit être en HTTPS.
        </p>
      </div>
    </div>
  );

  const now = new Date(), same = (d, m) => { const x = new Date(d); return x.getFullYear() === now.getFullYear() && x.getMonth() === now.getMonth() && (m || x.getDate() === now.getDate()); };
  const okp = pays.filter(p => p.status === "Confirmée"), tocheck = pays.filter(p => p.status === "À vérifier"), pending = items.filter(l => l.status === "En attente");
  const sum = (a) => a.reduce((s, p) => s + p.amount, 0);
  const today = sum(okp.filter(p => same(p.date))), month = sum(okp.filter(p => same(p.date, true)));
  const setP = (id, status) => setPays(pays.map(p => p.id === id ? { ...p, status } : p));
  const dup = (p) => pays.some(q => q.id !== p.id && q.tx && q.tx === p.tx);
  const wa = (p) => "https://wa.me/227" + p.phone + "?text=" + encodeURIComponent(p.status === "Confirmée" ? "Bonjour, ton paiement de " + fcfa(p.amount) + " pour « " + p.listing + " » est confirmé (réf. " + p.ref + ")." : "Bonjour, nous n'avons pas pu vérifier ton paiement pour « " + p.listing + " » (réf. " + p.ref + "). Peux-tu renvoyer une preuve ?");
  const upd = (id, ch) => setItems(items.map(l => l.id === id ? { ...l, ...ch } : l));
  const del = (id) => setItems(items.filter(l => l.id !== id));
  const add = () => { if (n.title.trim().length < 5 || !(Number(n.prix) >= 5000)) return; setItems([{ id: Date.now(), title: n.title.trim(), quartier: n.quartier, type: n.type, prix: Number(n.prix), caution: "1 mois", colocs: 1, status: "Disponible", amen: ["Eau courante", "Électricité"], desc: "Ajouté par l'administrateur.", rules: RULES, near: "Commerces et transports à proximité", wa: "90000000", photos: [], verified: true, tone: TONES[items.length % 4] }, ...items]); setN({ ...n, title: "", prix: "" }); };
  const Stat = ({ t, v, s }) => <div className="gida-modern-card card rounded-2xl p-4 shadow-sm"><p className="mut text-xs font-semibold">{t}</p><p className="mt-1 text-xl font-extrabold" style={{ color: "var(--brand)" }}>{v}</p>{s && <p className="mut text-xs">{s}</p>}</div>;

  return (
    <div className="mx-auto max-w-5xl space-y-8 px-4 py-8">
      <div className="flex flex-wrap items-center justify-between gap-4 border-b pb-4" style={{ borderColor: "var(--line)" }}>
        <div>
          <h1 className="text-2xl font-extrabold flex items-center gap-2"><Icon n="shield" s={24} />Tableau de bord Administrateur</h1>
          <p className="mut text-xs mt-1">Gestion des offres, validation des paiements et contrôles.</p>
        </div>
        <button onClick={handleLogout} className="flex items-center gap-2 rounded-xl border px-3.5 py-2 text-xs font-bold text-red-500 hover:bg-red-50 dark:hover:bg-red-950/20 transition-colors" style={{ borderColor: "var(--line)" }}>
          <Icon n="logout" s={16} />Déconnexion
        </button>
      </div>

      <div className="grid grid-cols-2 gap-3 md:grid-cols-5">
        <Stat t="Annonces actives" v={items.filter(l => l.status === "Disponible").length} s={items.length + " au total"} />
        <Stat t="Contacts générés" v={contacts} s="clics WhatsApp" />
        <Stat t="Gains du jour" v={fcfa(today)} />
        <Stat t="Gains du mois" v={fcfa(month)} s={okp.length + " confirmés"} />
        <Stat t="À valider" v={pending.length + tocheck.length} s={pending.length + " annonces · " + tocheck.length + " paiements"} />
      </div>

      <section>
        <h2 className="text-lg font-extrabold flex items-center gap-2">Annonces à approuver ({pending.length})</h2>
        {pending.length ? <div className="mt-3 space-y-2">{pending.map(l => <div key={l.id} className="gida-modern-card card flex flex-wrap items-center justify-between gap-2 rounded-2xl p-3.5 shadow-sm"><div><p className="font-bold">{l.title}</p><p className="mut text-xs">{l.quartier} · {l.type} · {fcfa(l.prix)}</p></div>
          <div className="flex gap-2"><button onClick={() => upd(l.id, { status: "Disponible" })} className="rounded-full bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition-opacity hover:opacity-90">Approuver</button><button onClick={() => del(l.id)} className="rounded-full bg-red-600 px-4 py-2 text-xs font-bold text-white transition-opacity hover:opacity-90">Refuser</button></div></div>)}</div>
          : <p className="gida-modern-card card mut mt-2 rounded-xl p-4 text-sm">Aucune demande en attente d'approbation.</p>}
      </section>

      <section>
        <h2 className="text-lg font-extrabold flex items-center gap-2">Paiements à vérifier ({tocheck.length})</h2>
        {tocheck.length ? <div className="mt-3 space-y-3">{tocheck.map(p => <div key={p.id} className="gida-modern-card card rounded-2xl p-4 shadow-sm"><div className="flex gap-3">
          {p.proof ? <a href={p.proof} target="_blank" rel="noopener noreferrer"><img src={p.proof} alt="Preuve" className="h-24 w-20 rounded-lg object-cover shadow-sm" /></a> : <div className="mut grid h-24 w-20 shrink-0 place-items-center rounded-lg p-1 text-center text-xs border" style={{ background: "var(--soft)", borderColor: "var(--line)" }}>Pas d'image (démo)</div>}
          <div className="min-w-0 flex-1 text-sm"><p className="font-bold">{p.listing}</p><p className="mut text-xs">{p.op} · {fcfa(p.amount)} · +227 {p.phone}</p><p className="mut text-xs font-mono">ID : {p.tx} · Réf. {p.ref}</p>{dup(p) && <p className="mt-1 text-xs font-bold text-red-500">⚠ Attention : Cet ID de transaction a déjà été utilisé !</p>}</div></div>
          <div className="mt-3 flex gap-2"><button onClick={() => setP(p.id, "Confirmée")} className="rounded-full bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition-opacity hover:opacity-90">Confirmer</button><button onClick={() => setP(p.id, "Rejetée")} className="rounded-full bg-red-600 px-4 py-2 text-xs font-bold text-white transition-opacity hover:opacity-90">Rejeter</button></div></div>)}</div>
          : <p className="gida-modern-card card mut mt-2 rounded-xl p-4 text-sm">Aucun paiement en attente de vérification.</p>}
        <p className="mut mt-2 text-xs flex items-center gap-1">💡 Vérifiez toujours l'ID et le montant directement dans votre historique Mobile Money pour écarter toute capture falsifiée.</p>
      </section>

      <section>
        <h2 className="text-lg font-extrabold">Toutes les annonces</h2>
        <div className="mt-3 space-y-2">{items.map(l => <div key={l.id} className="gida-modern-card card flex flex-wrap items-center justify-between gap-2 rounded-2xl p-3.5 shadow-sm"><div><p className="font-bold">{l.title}</p><p className="mut text-xs">{l.quartier} · {fcfa(l.prix)}</p></div>
          <div className="flex items-center gap-2"><span className="rounded-full px-3 py-1 text-xs font-bold" style={{ background: "var(--soft)", color: "var(--brand)" }}>{l.status}</span>
            {l.status !== "En attente" && <button onClick={() => upd(l.id, { status: l.status === "Disponible" ? "Loué" : "Disponible" })} className="flex items-center gap-1 rounded-full border px-3 py-2 text-xs font-bold transition-colors hover:bg-black/5" style={{ borderColor: "var(--line)" }}><Icon n="swap" s={14} />{l.status === "Disponible" ? "Marquer loué" : "Rendre dispo"}</button>}
            <button onClick={() => del(l.id)} aria-label="Supprimer" className="rounded-full bg-red-600 p-2 text-white hover:bg-red-700 transition-colors"><Icon n="trash" s={14} /></button></div></div>)}</div>
      </section>

      <section>
        <h2 className="text-lg font-extrabold">Ajouter rapidement un logement</h2>
        <div className="gida-modern-card card mt-3 grid gap-3 rounded-2xl p-4 sm:grid-cols-5 shadow-sm">
          <input className={inp + " sm:col-span-2"} style={ist} placeholder="Titre du logement" value={n.title} onChange={e => setN({ ...n, title: e.target.value })} />
          <input type="number" className={inp} style={ist} placeholder="Prix FCFA" value={n.prix} onChange={e => setN({ ...n, prix: e.target.value })} />
          <select className={inp} style={ist} value={n.quartier} onChange={e => setN({ ...n, quartier: e.target.value })}>{QUARTIERS.map(x => <option key={x}>{x}</option>)}</select>
          <button onClick={add} className="btn rounded-xl px-4 py-3 text-sm font-bold shadow-sm">Ajouter</button>
        </div>
      </section>

      <section>
        <h2 className="flex items-center gap-2 text-lg font-extrabold"><Icon n="wallet" s={18} />Historique des paiements</h2>
        <div className="gida-modern-card card mt-3 divide-y rounded-2xl text-sm shadow-sm" style={{ borderColor: "var(--line)" }}>
          {[...pays].filter(p => p.status !== "À vérifier").sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 12).map(p =>
            <div key={p.id} className="flex items-center justify-between gap-3 p-3.5" style={{ borderColor: "var(--line)" }}>
              <div><p className="font-semibold">{p.listing}</p><p className="mut text-xs">{p.op} · {fcfa(p.amount)} · <span className={p.status === "Confirmée" ? "text-emerald-600 font-bold" : "text-red-500 font-bold"}>{p.status}</span> · {new Date(p.date).toLocaleDateString("fr-FR")}</p></div>
              <a href={wa(p)} target="_blank" rel="noopener noreferrer" className="flex shrink-0 items-center gap-1 rounded-full bg-emerald-600 px-3.5 py-1.5 text-xs font-bold text-white transition-opacity hover:opacity-90"><Icon n="msg" s={14} />Prévenir</a>
            </div>)}
        </div>
      </section>
    </div>);
}

function App() {
  const [view, setView] = useState("home"), [items, setItems] = useState(SEED), [pays, setPays] = useState(PAY0), [contacts, setContacts] = useState(12);
  const [f, setF] = useState({ quartier: "", type: "", budget: 100000 }), [detail, setDetail] = useState(null), [payFor, setPayFor] = useState(null), [toast, setToast] = useState("");
  const say = (m) => { setToast(m); setTimeout(() => setToast(""), 2400); };
  const go = (v) => { setView(v); window.scrollTo(0, 0); };
  const visible = items.filter(l => l.status !== "En attente");
  const contact = () => setContacts(c => c + 1);
  const submit = (x) => { setItems([{ id: Date.now(), ...x, title: x.title.trim(), prix: Number(x.prix), desc: x.desc || "Aucune description.", rules: RULES, near: "Commerces et transports à proximité", status: "En attente", verified: false, tone: TONES[items.length % 4] }, ...items]); say("Annonce envoyée pour validation"); go("home"); };
  const proof = (x) => setPays(p => [...p, { id: Date.now(), date: new Date().toISOString(), listing: x.l.title, amount: FEE, op: x.op, phone: x.phone, tx: x.tx, ref: x.ref, proof: x.img, status: "À vérifier" }]);
  const tab = (v, icon, label) => <button onClick={() => go(v)} className="flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-bold transition-all" style={view === v ? { background: "var(--soft)", color: "var(--brand)" } : {}}><Icon n={icon} s={18} /><span className="hidden md:inline">{label}</span></button>;

  return (
    <div className="min-h-screen flex flex-col justify-between">
      <div>
        <header className="sticky top-0 z-30 backdrop-blur-custom shadow-sm" style={{ background: "color-mix(in srgb, var(--bg) 88%, transparent)", borderBottom: "1px solid var(--line)" }}>
          <div className="mx-auto flex max-w-5xl items-center justify-between px-3.5 py-2.5">
            <button onClick={() => go("home")} className="flex items-center gap-2 text-lg font-extrabold tracking-tight"><span className="btn grid h-9 w-9 place-items-center rounded-xl shadow-sm"><Icon n="home" s={20} /></span><span className="hidden min-[420px]:inline">Gida Coloc</span></button>
            <nav className="flex items-center gap-1">{tab("home", "home", "Accueil")}{tab("search", "search", "Trouver")}{tab("admin", "shield", "Admin")}
              <button onClick={() => go("publish")} className="btn ml-1 flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-bold shadow-md"><Icon n="plus" s={16} /><span className="hidden min-[520px]:inline">Publier une annonce</span><span className="min-[520px]:hidden">Publier</span></button></nav></div></header>
        <main className="gida-page-motion">
          {view === "home" && <Home items={visible} go={go} setF={setF} onDetail={setDetail} onContact={contact} />}
          {view === "search" && <Search items={visible} f={f} setF={setF} onDetail={setDetail} onContact={contact} />}
          {view === "publish" && <Publish onSubmit={submit} />}
          {view === "admin" && <Admin items={items} setItems={setItems} pays={pays} setPays={setPays} contacts={contacts} />}
        </main>
      </div>
      <footer className="mt-12 px-4 py-8 text-sm" style={{ background: "var(--foot)", color: "#E8D5C4" }}>
        <div className="mx-auto max-w-5xl flex flex-wrap justify-between items-center gap-4">
          <div>
            <p className="font-extrabold text-white text-base">Gida Coloc · Maradi</p>
            <p className="mt-1 text-xs opacity-60">© 2026 Plateforme de Colocation à Maradi, Niger.</p>
          </div>
          <div className="text-xs opacity-50 text-right">
            <span>Prototype sécurisé · Frontend React</span>
          </div>
        </div>
      </footer>
      {detail && <Detail l={detail} onClose={() => setDetail(null)} onContact={contact} onReserve={(l) => { setDetail(null); setPayFor(l); }} />}
      {payFor && <PayModal l={payFor} onClose={() => setPayFor(null)} onSubmit={proof} />}
      {toast && <div className="fixed bottom-6 left-1/2 z-[60] -translate-x-1/2 rounded-full px-5 py-2.5 text-sm font-semibold shadow-2xl animate-bounce" style={{ background: "var(--ink)", color: "var(--bg)" }}>{toast}</div>}
    </div>);
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>

<script>
(function(){
  const mark=()=>{
    document.querySelectorAll('main article.card, main section, main .card').forEach((el,i)=>{
      if(!el.classList.contains('gida-motion') && !el.closest('.fixed')) el.classList.add('gida-motion');
    });
  };
  mark();
  const obs=new MutationObserver(()=>mark());
  obs.observe(document.getElementById('root'),{childList:true,subtree:true});
  window.addEventListener('beforeunload',()=>obs.disconnect(),{once:true});
})();
</script>

</body>
